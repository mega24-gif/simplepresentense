        function initQuiz() {
            quizCurrentIndex = 0;
            quizAnswers = new Array(fullQuizQuestions.length).fill(null);
            quizQuestionsData = [...fullQuizQuestions]; // or shuffle if desired
            renderQuizQuestion();
        }

        function renderQuizQuestion() {
            if (quizCurrentIndex >= quizQuestionsData.length) {
                renderResultView();
                return;
            }

            const item = quizQuestionsData[quizCurrentIndex];
            document.getElementById('quizCounter').innerText = `Soal ${quizCurrentIndex + 1} dari ${quizQuestionsData.length}`;

            let html = `
                <div class="space-y-4">
                    <div class="bg-indigo-50/50 p-4 rounded-2xl border font-semibold text-slate-800 text-sm">
                        ${quizCurrentIndex + 1}. ${item.q}
                    </div>
                    <div class="space-y-2">
            `;

            item.options.forEach((opt, idx) => {
                const isSelected = quizAnswers[quizCurrentIndex] === idx;
                html += `<button onclick="selectQuizOption(${idx})" class="w-full p-3.5 rounded-xl border text-left text-xs font-medium transition ${isSelected ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white hover:bg-indigo-50'}">${opt}</button>`;
            });

            html += `
                    </div>
                    <div class="flex justify-between pt-4 border-t">
                        <button onclick="navQuiz(-1)" ${quizCurrentIndex === 0 ? 'disabled' : ''} class="px-4 py-2 bg-slate-100 rounded-xl text-xs font-semibold ${quizCurrentIndex === 0 ? 'opacity-50' : ''}">Sebelumnya</button>
                        <button onclick="navQuiz(1)" class="px-4 py-2 bg-indigo-600 text-white rounded-xl text-xs font-semibold">${quizCurrentIndex === quizQuestionsData.length - 1 ? 'Selesai & Kirim' : 'Selanjutnya'}</button>
                    </div>
                </div>
            `;

            document.getElementById('quizContainer').innerHTML = html;
        }

        function selectQuizOption(optIdx) {
            quizAnswers[quizCurrentIndex] = optIdx;
            renderQuizQuestion();
        }

        function navQuiz(direction) {
            quizCurrentIndex += direction;
            if (quizCurrentIndex >= quizQuestionsData.length) {
                renderResultView();
            } else {
                renderQuizQuestion();
            }
        }

        function renderResultView() {
            let correctCount = 0;
            quizAnswers.forEach((ans, idx) => {
                if (ans === quizQuestionsData[idx].ans) correctCount++;
            });

            const incorrectCount = quizQuestionsData.length - correctCount;
            const finalScore = (correctCount / quizQuestionsData.length) * 100;

            let category = "Let's Learn Again!";
            if (finalScore >= 90) category = "Excellent! 🌟";
            else if (finalScore >= 80) category = "Very Good! 👏";
            else if (finalScore >= 70) category = "Good! 👍";
            else if (finalScore >= 60) category = "Keep Practicing! 💪";

            document.getElementById('resultStudentMeta').innerText = `${currentUser.name} • Kelas ${currentUser.className} • Absen ${currentUser.absen}`;
            document.getElementById('resCorrect').innerText = correctCount;
            document.getElementById('resIncorrect').innerText = incorrectCount;
            document.getElementById('resScore').innerText = finalScore;
            document.getElementById('resCategory').innerText = category;

            appProgress.quizDone = true;
            updateProgressUI();

            switchView('viewResult');
        }

        function submitFinalResultToCloud() {
            const ref1 = document.getElementById('ref1').value.trim();
            const ref2 = document.getElementById('ref2').value.trim();
            
            let correctCount = 0;
            quizAnswers.forEach((ans, idx) => {
                if (ans === quizQuestionsData[idx].ans) correctCount++;
            });
            const finalScore = (correctCount / quizQuestionsData.length) * 100;

            const payload = {
                submissionId: "SUB_" + Date.now() + "_" + currentUser.absen,
                studentId: currentUser.absen,
                studentName: currentUser.name,
                className: currentUser.className,
                material: APP_CONFIG.topic,
                totalQuestions: quizQuestionsData.length,
                correctAnswers: correctCount,
                incorrectAnswers: quizQuestionsData.length - correctCount,
                score: finalScore,
                reflection1: ref1,
                reflection2: ref2
            };

            // Jika URL Apps Script belum diisi, berikan simulasi sukses yang ramah
            if (!APP_CONFIG.googleAppsScriptUrl || APP_CONFIG.googleAppsScriptUrl.includes("MASUKKAN")) {
                showCustomModal("Simulasi Pengiriman Berhasil!\n\nCatatan: Guru dapat menghubungkan Google Apps Script Web App URL agar nilai otomatis masuk ke Google Sheets spreadsheet 'NILAI INTERAKTIF BAHASA INGGRIS KELAS VIII'.");
                return;
            }

            fetch(APP_CONFIG.googleAppsScriptUrl, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }).then(() => {
                showCustomModal("Nilai berhasil dikirim dan dicatat ke Google Sheets!");
            }).catch(err => {
                showCustomModal("Gagal mengirim ke server. Periksa koneksi internet.");
            });
        }

        function openExternalResources() {
            window.open(APP_CONFIG.googleDocsUrl, '_blank');
        }

        function showCustomModal(message) {
            alert(message); // Custom alert fallback compliant with safe sandbox UI
        }
    </script>
</body>
</html>
